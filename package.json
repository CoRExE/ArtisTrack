{
  "name": "artistrack",
  "version": "1.0.1",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.19",
    "expo-asset": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "^57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-location": "~57.0.15",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.40.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nfc-manager": "^3.17.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:db": "python3 scripts/build-db.py",
    "build:apk": "expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod:android": "eas build --profile production --platform android",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:prod:all": "eas build --profile production --platform all",
    "build:update": "eas update",
    "release": "release-it"
  },
  "private": true
}